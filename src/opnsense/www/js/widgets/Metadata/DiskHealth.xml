            <f_poweron>Power-on time</f_poweron>
            <f_identity>Model details (serial, firmware, capacity)</f_identity>
            <status_ok>Healthy</status_ok>
            <status_warning>Warning</status_warning>
            <status_critical>Critical</status_critical>
            <status_unknown>Unknown</status_unknown>
            <serial>Serial</serial>
            <firmware>Firmware</firmware>
            <capacity>Capacity</capacity>
            <standby>standby, last known values</standby>
